# --- model -------------------------------------------------------------
ANTHROPIC_API_KEY=                       # your Claude API key (the SDK reads it)
ITSM_SERVER_SIDE_FALLBACK=true           # server-side refusal fallback (beta); set false if your platform lacks it

# --- connectors: "fixture" = built-in fake Jira/ServiceNow/Zendesk with known answers; "live" = real APIs
ITSM_CONNECTOR_MODE=fixture
# ITSM_FIXED_NOW=2026-11-23T09:00:00+00:00   # pin "now" for reproducible demos

JIRA_BASE_URL=                           # https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_TIMEZONE=UTC                        # time zone of the Jira account (JQL dates are interpreted in it)
JIRA_CAB_FIELD=customfield_10050         # your "CAB approval" custom field id
JIRA_LINKED_CHANGE_FIELD=customfield_10051   # field holding the linked ServiceNow change number

SERVICENOW_BASE_URL=                     # https://your-instance.service-now.com
SERVICENOW_USER=
SERVICENOW_PASSWORD=
SERVICENOW_TIMEZONE=UTC                  # time zone of the integration user

ZENDESK_BASE_URL=                        # https://your-subdomain.zendesk.com
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
ITSM_STRICT_TOOLS=true                   # set false if the API reports a tool schema as too complex
