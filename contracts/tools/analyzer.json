{
  "server": "analyzer",
  "provenance": "custom-built (deterministic computation over the record store)",
  "transport": "in-process / streamable-http",
  "auth": "platform internal (job-scoped token)",
  "rate_limit": "n/a",
  "tools": [
    {
      "name": "analyzer_resultset_describe",
      "description": "Row count, columns, completeness proof and field value distributions of a handle.",
      "risk_tier": "read",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "bulk_to_resultset": false,
      "allowed_roles": [
        "orchestrator",
        "explorer"
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "handle": {
            "type": "string",
            "description": "Result-set handle, e.g. rs_01HZX3K9"
          }
        },
        "required": [
          "handle"
        ]
      },
      "returns": "handle_summary"
    },
    {
      "name": "analyzer_records_sample",
      "description": "Return up to 25 records (fenced, sanitised) from a handle, optionally filtered. For inspection only, never for counting.",
      "risk_tier": "read",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "bulk_to_resultset": false,
      "allowed_roles": [
        "orchestrator",
        "explorer"
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "handle": {
            "type": "string"
          },
          "n": {
            "type": "integer"
          },
          "filters": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "field": {
                  "type": "string"
                },
                "op": {
                  "type": "string",
                  "enum": [
                    "eq",
                    "neq",
                    "in",
                    "not_in",
                    "contains",
                    "gte",
                    "lt",
                    "is_null",
                    "not_null"
                  ]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "field",
                "op",
                "value"
              ]
            }
          },
          "label_filter": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "handle",
          "n"
        ]
      },
      "returns": "records"
    },
    {
      "name": "analyzer_resultset_filter",
      "description": "Create a new handle with rows matching structured filters (field op value).",
      "risk_tier": "read",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "bulk_to_resultset": false,
      "allowed_roles": [
        "orchestrator",
        "explorer"
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "handle": {
            "type": "string"
          },
          "filters": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "field": {
                  "type": "string"
                },
                "op": {
                  "type": "string",
                  "enum": [
                    "eq",
                    "neq",
                    "in",
                    "not_in",
                    "contains",
                    "gte",
                    "lt",
                    "is_null",
                    "not_null"
                  ]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "field",
                "op",
                "value"
              ]
            }
          },
          "label_filter": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "handle",
          "filters"
        ]
      },
      "returns": "handle_summary"
    },
    {
      "name": "analyzer_resultset_union",
      "description": "Union handles and dedupe by a key expression (e.g. normalised change number).",
      "risk_tier": "read",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "bulk_to_resultset": false,
      "allowed_roles": [
        "orchestrator",
        "explorer"
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "handles": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Result-set handle, e.g. rs_01HZX3K9"
            }
          },
          "dedupe_key": {
            "type": "string"
          }
        },
        "required": [
          "handles",
          "dedupe_key"
        ]
      },
      "returns": "handle_summary + duplicate stats"
    },
    {
      "name": "analyzer_resultset_join",
      "description": "Join two handles on keys; returns matched / left-only / right-only handles and counts.",
      "risk_tier": "read",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "bulk_to_resultset": false,
      "allowed_roles": [
        "orchestrator",
        "explorer"
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "left": {
            "type": "string"
          },
          "right": {
            "type": "string"
          },
          "left_key": {
            "type": "string"
          },
          "right_key": {
            "type": "string"
          }
        },
        "required": [
          "left",
          "right",
          "left_key",
          "right_key"
        ]
      },
      "returns": "3 handles + counts"
    },
    {
      "name": "analyzer_classify",
      "description": "Run the batched map phase over a handle with a versioned rubric. Long-running: returns a progress handle; final labels are stored as annotations.",
      "risk_tier": "low",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "bulk_to_resultset": false,
      "allowed_roles": [
        "orchestrator"
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "handle": {
            "type": "string",
            "description": "Result-set handle, e.g. rs_01HZX3K9"
          },
          "rubric_id": {
            "type": "string"
          },
          "only_undecided": {
            "type": "boolean"
          }
        },
        "required": [
          "handle",
          "rubric_id",
          "only_undecided"
        ]
      },
      "returns": "classification job id + progress"
    },
    {
      "name": "analyzer_aggregate",
      "description": "Compute a fact: count/sum/min/max/count_distinct grouped by fields, over a handle and optional label filter. The only valid source of numbers in answers.",
      "risk_tier": "read",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "bulk_to_resultset": false,
      "allowed_roles": [
        "orchestrator",
        "explorer"
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "handle": {
            "type": "string"
          },
          "metric": {
            "type": "string",
            "enum": [
              "count",
              "count_distinct",
              "sum",
              "min",
              "max"
            ]
          },
          "filters": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "field": {
                  "type": "string"
                },
                "op": {
                  "type": "string",
                  "enum": [
                    "eq",
                    "neq",
                    "in",
                    "not_in",
                    "contains",
                    "gte",
                    "lt",
                    "is_null",
                    "not_null"
                  ]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "field",
                "op",
                "value"
              ]
            }
          },
          "group_by": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "metric_field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "label_filter": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "handle",
          "metric",
          "description"
        ]
      },
      "returns": "fact {fact_id, value, sql}"
    },
    {
      "name": "analyzer_list_create",
      "description": "Define a rendered list (placeholder {{list:L-n}}) over a handle: columns, structured filters, optional label filter and sort. The renderer expands it from the database, so lists are exact by construction.",
      "risk_tier": "read",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "bulk_to_resultset": false,
      "allowed_roles": [
        "orchestrator",
        "explorer"
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "handle": {
            "type": "string"
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "filters": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "field": {
                  "type": "string"
                },
                "op": {
                  "type": "string",
                  "enum": [
                    "eq",
                    "neq",
                    "in",
                    "not_in",
                    "contains",
                    "gte",
                    "lt",
                    "is_null",
                    "not_null"
                  ]
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "field",
                "op",
                "value"
              ]
            }
          },
          "label_filter": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "sort": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "handle",
          "columns"
        ]
      },
      "returns": "list id"
    },
    {
      "name": "analyzer_export",
      "description": "Export a handle or list to CSV or XLSX; returns a download link valid for 24h.",
      "risk_tier": "low",
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "bulk_to_resultset": false,
      "allowed_roles": [
        "orchestrator"
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "list_key": {
            "type": "string"
          },
          "format": {
            "type": "string",
            "enum": [
              "csv"
            ]
          }
        },
        "required": [
          "list_key",
          "format"
        ]
      },
      "returns": "export id + url"
    }
  ]
}
